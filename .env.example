# Copy this file to .env and fill in the values. Never commit .env.

# --- PostgreSQL / PostGIS: use the restricted read-only role from setup_readonly_user.sql ---
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=powell_analytics
PG_USER=powell_agent_ro
PG_PASSWORD=change-me
# disable | allow | prefer | require | verify-ca | verify-full  (use require/verify-full online)
PG_SSLMODE=prefer

# Schemas the agent may read (comma-separated, matched case-insensitively)
APPROVED_SCHEMAS=salesdata,data_science,gis,public,training
# Optional: schema.table entries that must never be exposed, e.g. public.users,gis.private_sites
BLOCKED_TABLES=

# Safety limits
MAX_ROWS=5000
STATEMENT_TIMEOUT_MS=15000

# --- OpenAI ---
OPENAI_API_KEY=sk-change-me
OPENAI_MODEL=gpt-5.6-luna
# responses (default, required for tools + reasoning on gpt-5.x models) | chat
OPENAI_API_STYLE=responses
# Optional reasoning effort: low | medium | high (blank = model default)
OPENAI_REASONING_EFFORT=
# Optional: a compatible endpoint (e.g. Azure/OpenAI proxy). Leave blank for api.openai.com
OPENAI_BASE_URL=
# Maximum sample rows sent to the model per tool result (aggregates are always computed locally)
LLM_MAX_SAMPLE_ROWS=20
AGENT_MAX_STEPS=12

# --- GIS ---
DEFAULT_CRS_EPSG=4326
BRITISH_CRS_EPSG=27700
# Force a metric CRS for distance/area (blank = auto: 27700 for Great Britain, otherwise local UTM)
METRIC_CRS_OVERRIDE_EPSG=

# --- Access control: REQUIRED when the app is online ---
APP_PASSWORD=

# --- Branding ---
BRAND_NAME=Powell A. Ndlovu
BRAND_TAGLINE=GIS, remote sensing and data analytics
# Your photo/logo. Default: assets/logo.jpg (or .png/.webp). Cropped to a square automatically.
BRAND_LOGO_PATH=

# --- Application ---
MAX_UPLOAD_MB=200
LOG_LEVEL=INFO
